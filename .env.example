# ---------------------------------------------------------------
# CareerPulse configuration
# Copy this file to ".env" (in the project root) and fill in values.
# ---------------------------------------------------------------

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model (free tier). Free-tier quotas are PER MODEL PER DAY and can be small
# (e.g. gemini-2.5-flash allows only 20 requests/day), so Flash-Lite is the default.
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated backups, used automatically when a model's daily quota runs out
# or it is overloaded. Check your limits at https://aistudio.google.com/rate-limit
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash

# MongoDB connection string (local or Atlas free tier)
MONGODB_URI=mongodb://localhost:27017/careerpulse

# Express server port
PORT=5000

# Where the React app runs (used for CORS + post-login redirect)
CLIENT_URL=http://localhost:5173

# ---------------- Optional tuning ----------------
# How many days back to search Gmail
SYNC_DAYS=30
# Max NEW emails to classify per sync (keeps you within free-tier limits)
SYNC_MAX_EMAILS=50
# Delay between Gemini calls in milliseconds. 4000 suits the free tier; a paid key is fine with 1000.
GEMINI_DELAY_MS=4000
# Most AI requests allowed per day (retries included). AI features pause with a clear message once it's reached.
GEMINI_DAILY_REQUEST_LIMIT=500
# Max retries on 429 / quota errors
GEMINI_MAX_RETRIES=4
# Minimum AI confidence required to create/update an application
MIN_CONFIDENCE=0.6
# Path to the Google OAuth client file (default: credentials.json in project root)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Signs the login cookie (any long random string). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
